{
  "name": "nsfw",
  "version": "2.3.1",
  "description": "A simple file watcher for Node",
  "main": "js/dist/index.js",
  "scripts": {
    "build": "node js/scripts/build.js",
    "prepare": "node js/scripts/build.js",
    "lint": "oxlint js/src js/spec",
    "test:types": "node js/scripts/build.js && tsc -p js/spec/types",
    "test": "pnpm lint && node js/scripts/test.js",
    "test:nolint": "node js/scripts/test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axosoft/node-simple-file-watcher.git"
  },
  "author": "Axosoft, LLC",
  "types": "js/dist/index.d.ts",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/axosoft/node-simple-file-watcher/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "js/dist",
    "src",
    "includes",
    "binding.gyp"
  ],
  "homepage": "https://github.com/axosoft/node-simple-file-watcher",
  "dependencies": {
    "node-addon-api": "^8.9.2"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^6.0.1",
    "@types/node": "^22.20.5",
    "oxlint": "^1.95.0",
    "typescript": "~7.0.2"
  },
  "keywords": [
    "FileWatcher",
    "files",
    "watch",
    "filewatch",
    "file",
    "inotify",
    "fsevents"
  ],
  "packageManager": "pnpm@12.23.0"
}
