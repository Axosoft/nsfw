{
  "name": "nsfw",
  "version": "2.3.1",
  "description": "A simple file watcher for Node",
  "main": "js/dist/index.js",
  "scripts": {
    "build": "node js/scripts/build.js",
    "prepare": "node js/scripts/build.js",
    "lint": "eslint --ext .js,.ts js/src js/spec",
    "test:types": "node js/scripts/build.js && tsc -p js/spec/types",
    "test": "pnpm lint && node js/scripts/test.js",
    "test:nolint": "node js/scripts/test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/axosoft/node-simple-file-watcher.git"
  },
  "author": "Axosoft, LLC",
  "types": "js/dist/index.d.ts",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/axosoft/node-simple-file-watcher/issues"
  },
  "engines": {
    "node": "^18 || ^20 || >=21"
  },
  "files": [
    "js/dist",
    "src",
    "includes",
    "binding.gyp"
  ],
  "homepage": "https://github.com/axosoft/node-simple-file-watcher",
  "dependencies": {
    "node-addon-api": "^8.0.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.130",
    "@typescript-eslint/eslint-plugin": "^8.74.0",
    "@typescript-eslint/parser": "^8.74.0",
    "eslint": "8.x",
    "executive": "^1.6.3",
    "fs-extra": "^11.2.0",
    "globals": "^15.8.0",
    "mocha": "^10.6.0",
    "typescript": "~6.0.3"
  },
  "keywords": [
    "FileWatcher",
    "files",
    "watch",
    "filewatch",
    "file",
    "inotify",
    "fsevents"
  ],
  "packageManager": "pnpm@12.23.0"
}
